        {
          "name": "Update Ticket Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newStatus\": \"EN_PROGRESO\",\n  \"observation\": \"Starting work on hardware issue\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/tickets/{{created_ticket_id}}/status",
              "host": ["{{base_url}}"],
              "path": ["api", "tickets", "{{created_ticket_id}}", "status"]
            },
            "description": "Update ticket status. Requires TECNICO or ADMIN role."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Status updated\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.equal(\"EN_PROGRESO\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
