            },
            "description": "Reassign ticket to available technician. ADMIN role required."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Ticket has technician assigned\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.assignedTechnicianId).to.exist;",
                  "    pm.expect(jsonData.status).to.equal(\"ASIGNADO\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
