      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ticketId\": 456,\n  \"categoria\": \"SOFTWARE\",\n  \"prioridad\": \"MEDIA\"\n}"
        },
        "url": {
          "raw": "{{dispatch_url}}/technician-dispatch",
          "host": ["{{dispatch_url}}"],
          "path": ["technician-dispatch"]
        },
        "description": "Test dispatch with different category (SOFTWARE) and priority (MEDIA)."
      },
      "response": []
    },
